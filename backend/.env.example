# ============================================================
# TecnoStock - plantilla de configuración
# Copiar a .env y completar. El archivo .env NO se versiona.
# ============================================================

# Aplicación
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# SQL Server
# Desarrollo local: autenticación de Windows (Trusted_Connection).
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=.\SQLEXPRESS
DB_NAME=TecnoStock
DB_TRUSTED_CONNECTION=true
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_SIZE=5
DB_TIMEOUT=5

# Producción con login SQL de mínimo privilegio:
# DB_TRUSTED_CONNECTION=false
# DB_USER=tecnostock_app
# DB_PASSWORD=<contraseña-fuerte>

# Seguridad
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<secreto-de-al-menos-32-caracteres>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS: orígenes separados por coma
CORS_ORIGINS=http://localhost:4200

# Administrador inicial (solo se crea si no existe)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=<contraseña-de-al-menos-8-caracteres>
BOOTSTRAP_ADMIN_FULLNAME=Administrador TecnoStock
